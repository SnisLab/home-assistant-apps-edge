#!/usr/bin/env bashio

exit_code=${1}
signal=${2:-0}

if [[ "${exit_code}" -eq 256 ]]; then
    bashio::log.warning "Pulse2MQTT was terminated by signal ${signal}"
    echo "$((128 + signal))" > /run/s6-linux-init-container-results/exitcode
    exec /run/s6/basedir/bin/halt
fi

if [[ "${exit_code}" -ne 0 ]]; then
    bashio::log.warning "Pulse2MQTT stopped with exit code ${exit_code}"
    echo "${exit_code}" > /run/s6-linux-init-container-results/exitcode
    exec /run/s6/basedir/bin/halt
fi

bashio::log.info "Pulse2MQTT service stopped"
